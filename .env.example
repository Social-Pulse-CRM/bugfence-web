# Public site config (NEXT_PUBLIC_* is exposed to the browser - never put secrets here)
NEXT_PUBLIC_SITE_URL=https://bug-fence.com
# Product app base URL (Hosted Dashboard / SaaS)
NEXT_PUBLIC_APP_URL=https://bugfence.socialpulsecrm.com
# Product app registration and login URLs
NEXT_PUBLIC_APP_REGISTER_URL=https://bugfence.socialpulsecrm.com
NEXT_PUBLIC_APP_LOGIN_URL=https://bugfence.socialpulsecrm.com
# Public npm package page / registry URL for the BugFence SDK
NEXT_PUBLIC_NPM_URL=https://www.npmjs.com/package/@socialpulsecrm/bugfence-react
# Public npm package name, e.g. the name users type in npm install
NEXT_PUBLIC_NPM_PACKAGE=@socialpulsecrm/bugfence-react
NEXT_PUBLIC_DOCS_URL=https://docs.bug-fence.com
NEXT_PUBLIC_GITHUB_URL=https://github.com/socialpulsecrm/Crawler
NEXT_PUBLIC_CONTACT_EMAIL=support@bug-fence.com

# Feature Flags
# Controls visibility of Self-Hosted deployment options and offline enterprise license guides (default: true)
NEXT_PUBLIC_ENABLE_SELF_HOSTED=true
